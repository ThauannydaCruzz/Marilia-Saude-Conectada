# URL do painel Cuida (Front-End). Em dev, a porta em que ele sobe (ver raiz do monorepo).
VITE_CUIDA_URL=http://localhost:8081

# URL do painel Vigia. Em dev, a porta em que ele sobe (ver raiz do monorepo).
VITE_VIGIA_URL=http://localhost:8082

# URL da API do backend do Cuida — é contra ela que o login único autentica
# (tabela clientes é a única fonte de identidade compartilhada pelos dois sistemas).
VITE_CUIDA_API_URL=http://localhost:3333/api
